<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meridian Banking — Account Overview</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background: #0b1120;
      color: #0f172a;
      min-height: 100vh;
      padding: 16px;
      display: flex;
      justify-content: center;
      align-items: flex-start;
    }

    .shell {
      width: 100%;
      max-width: 820px;
      background: #f1f5f9;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 24px 50px rgba(0, 0, 0, 0.45);
      border: 1px solid #1e293b;
      margin-top: 8px;
      margin-bottom: 24px;
    }

    .topbar {
      background: #060b16;
      color: #ffffff;
      padding: 16px 22px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      border-bottom: 1px solid #1e293b;
    }

    .brand-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .logo {
      width: 34px;
      height: 34px;
      border-radius: 8px;
      background: linear-gradient(135deg, #1d4ed8, #0284c7);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 1rem;
      color: #ffffff;
    }

    .brand-title {
      font-weight: 700;
      font-size: 1.05rem;
      letter-spacing: 0.2px;
    }

    .brand-sub {
      font-size: 0.72rem;
      color: #94a3b8;
    }

    .top-right {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .pill-demo {
      background: #1e293b;
      color: #93c5fd;
      border: 1px solid #334155;
      font-size: 0.68rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .btn {
      border: none;
      border-radius: 8px;
      padding: 9px 14px;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
    }

    .btn-sm {
      padding: 6px 11px;
      font-size: 0.78rem;
    }

    .btn-outline {
      background: transparent;
      color: #e2e8f0;
      border: 1px solid #475569;
    }

    .btn-dark {
      background: #0f172a;
      color: #ffffff;
    }

    .btn-blue {
      background: #1d4ed8;
      color: #ffffff;
    }

    .btn-soft {
      background: #e2e8f0;
      color: #0f172a;
    }

    .btn-warn {
      background: #fef2f2;
      color: #b91c1c;
      border: 1px solid #fecaca;
    }

    .content {
      padding: 20px;
    }

    .block-banner {
      display: none;
      background: #fef2f2;
      border: 1px solid #f87171;
      color: #991b1b;
      border-radius: 12px;
      padding: 14px 16px;
      margin-bottom: 16px;
      font-size: 0.86rem;
      line-height: 1.45;
    }

    .block-banner.active {
      display: block;
    }

    .hero-card {
      background: linear-gradient(135deg, #0f172a 0%, #172554 100%);
      color: #ffffff;
      border-radius: 14px;
      padding: 22px;
      margin-bottom: 16px;
      border: 1px solid #1e3a8a;
    }

    .hero-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 10px;
    }

    .status-ok {
      background: rgba(16, 185, 129, 0.18);
      color: #6ee7b7;
      border: 1px solid rgba(110, 231, 183, 0.35);
      font-size: 0.72rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 999px;
    }

    .status-blocked {
      background: rgba(239, 68, 68, 0.22);
      color: #fca5a5;
      border: 1px solid rgba(252, 165, 165, 0.45);
    }

    .holders-line {
      font-size: 0.92rem;
      color: #e2e8f0;
      margin-bottom: 6px;
    }

    .balance-big {
      font-size: 2.15rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin: 4px 0 8px;
    }

    .sub-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(175px, 1fr));
      gap: 10px;
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.14);
      font-size: 0.78rem;
      color: #cbd5e1;
    }

    .sub-grid strong {
      display: block;
      color: #ffffff;
      font-size: 0.84rem;
      margin-top: 2px;
    }

    .actions-bar {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 10px;
      margin-bottom: 16px;
    }

    .card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 18px;
      margin-bottom: 16px;
    }

    .card-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 14px;
    }

    .card-title {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #475569;
    }

    .filter-row {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    .chip {
      border: 1px solid #cbd5e1;
      background: #f8fafc;
      color: #334155;
      border-radius: 999px;
      padding: 4px 11px;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
    }

    .chip.active {
      background: #0f172a;
      color: #ffffff;
      border-color: #0f172a;
    }

    .transfer-drawer {
      display: none;
    }

    .transfer-drawer.open {
      display: block;
    }

    .form-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 12px;
    }

    label {
      display: block;
      font-size: 0.74rem;
      font-weight: 700;
      text-transform: uppercase;
      color: #475569;
      margin-bottom: 5px;
    }

    input, select {
      width: 100%;
      padding: 9px 12px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      font-size: 0.9rem;
      background: #ffffff;
      color: #0f172a;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 10px;
    }

    .feat-item {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 13px;
    }

    .feat-item strong {
      display: block;
      font-size: 0.88rem;
      color: #0f172a;
      margin-bottom: 3px;
    }

    .feat-item span {
      font-size: 0.78rem;
      color: #64748b;
      line-height: 1.35;
    }

    .tx-table {
      list-style: none;
    }

    .tx-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 0;
      border-bottom: 1px solid #f1f5f9;
      gap: 12px;
    }

    .tx-row:last-child {
      border-bottom: none;
    }

    .tx-title {
      font-weight: 600;
      font-size: 0.9rem;
      color: #0f172a;
    }

    .tx-meta {
      font-size: 0.75rem;
      color: #64748b;
      margin-top: 2px;
    }

    .tx-right {
      text-align: right;
      white-space: nowrap;
    }

    .amt-in {
      color: #059669;
      font-weight: 700;
      font-size: 0.92rem;
    }

    .amt-out {
      color: #dc2626;
      font-weight: 700;
      font-size: 0.92rem;
    }

    .tx-tag {
      display: inline-block;
      font-size: 0.68rem;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 999px;
      margin-top: 3px;
    }

    .tag-in {
      background: #ecfdf5;
      color: #047857;
    }

    .tag-out {
      background: #fef2f2;
      color: #b91c1c;
    }

    .feedback {
      margin-top: 8px;
      font-size: 0.84rem;
      font-weight: 600;
    }

    .footer {
      text-align: center;
      padding: 14px 18px;
      font-size: 0.74rem;
      color: #64748b;
      background: #e2e8f0;
      border-top: 1px solid #cbd5e1;
    }

    @media (max-width: 560px) {
      .form-2 {
        grid-template-columns: 1fr;
      }
      .balance-big {
        font-size: 1.75rem;
      }
    }
  </style>
</head>
<body>
  <div class="shell">
    <header class="topbar">
      <div class="brand-wrap">
        <div class="logo">M</div>
        <div>
          <div class="brand-title">Meridian Banking</div>
          <div class="brand-sub">Commercial &amp; Private Client Division</div>
        </div>
      </div>
      <div class="top-right">
        <span class="pill-demo">Demo • Simulated Data</span>
        <button class="btn btn-outline btn-sm" onclick="signOut()">Sign Out</button>
      </div>
    </header>

    <div class="content">
      <!-- Bank Block / Hold Alert -->
      <div class="block-banner" id="blockBanner">
        <strong>BANK BLOCK ACTIVE (DEMO):</strong> Outbound transfers and card/wire releases are currently placed on a simulated security hold for <strong>Lena Baker</strong> &amp; <strong>Ligon Kelley</strong>. Toggle "Bank Block" below to lift or apply the simulated hold.
      </div>

      <!-- Main Account Card -->
      <section class="hero-card">
        <div class="hero-top">
          <span class="status-ok" id="availBadge">Funds Available • Active Standing</span>
          <span style="font-size: 0.78rem; color: #cbd5e1;">
            Session: <strong id="sessionHolder">Lena Baker &amp; Ligon Kelley</strong>
          </span>
        </div>

        <div class="holders-line">
          Joint Account Holders: <strong>Lena Baker</strong> &amp; <strong>Ligon Kelley</strong>
        </div>

        <div class="balance-big" id="balanceText">$2,500,000.00</div>

        <div class="sub-grid">
          <div>
            Account Number
            <strong>•••• •••• 8842</strong>
          </div>
          <div>
            Routing / Clearing
            <strong>021000884 (Demo)</strong>
          </div>
          <div>
            Bank Block Status
            <strong id="blockStateLabel">None (Unblocked)</strong>
          </div>
        </div>
      </section>

      <!-- Action Buttons -->
      <div class="actions-bar">
        <button class="btn btn-blue" onclick="toggleDrawer()">Send / Transfer Funds</button>
        <button class="btn btn-soft" onclick="simulateReceived()">+ Simulate Incoming</button>
        <button class="btn btn-warn" id="blockBtn" onclick="toggleBankBlock()">Apply Bank Block</button>
        <button class="btn btn-soft" onclick="togglePrivacy()">Hide / Show Balance</button>
      </div>

      <!-- Simulated Transfer Panel -->
      <section class="card transfer-drawer" id="transferDrawer">
        <div class="card-head">
          <span class="card-title">New Outbound Transfer (Simulated)</span>
        </div>
        <div class="form-2">
          <div>
            <label for="payTo">Recipient / Beneficiary</label>
            <input type="text" id="payTo" placeholder="e.g., Harbor Logistics LLC">
          </div>
          <div>
            <label for="payAmt">Amount (USD)</label>
            <input type="number" id="payAmt" placeholder="4500" min="1" step="0.01">
          </div>
        </div>
        <button class="btn btn-dark" onclick="sendDemoFunds()">Send Funds (Demo)</button>
        <div class="feedback" id="feedbackMsg"></div>
      </section>

      <!-- Banking Features Block -->
      <section class="card">
        <div class="card-head">
          <span class="card-title">Meridian Banking Features</span>
        </div>
        <div class="features-grid">
          <div class="feat-item">
            <strong>Dual Signatory View</strong>
            <span>Joint account profile for Lena Baker and Ligon Kelley.</span>
          </div>
          <div class="feat-item">
            <strong>Bank Block Controls</strong>
            <span>Simulated account freeze/block toggle with instant status banner.</span>
          </div>
          <div class="feat-item">
            <strong>Incoming &amp; Outbound Wires</strong>
            <span>Separate tracking for received credits and sent-out debits.</span>
          </div>
          <div class="feat-item">
            <strong>Statement &amp; Ledger Filter</strong>
            <span>Filter activity between All, Received (In), and Sent Out (Out).</span>
          </div>
        </div>
      </section>

      <!-- Transactions History (Many Sent Out & Received) -->
      <section class="card">
        <div class="card-head">
          <span class="card-title">Transaction History (Sent Out &amp; Received)</span>
          <div class="filter-row">
            <button class="chip active" id="f-all" onclick="setFilter('all')">All</button>
            <button class="chip" id="f-in" onclick="setFilter('in')">Received</button>
            <button class="chip" id="f-out" onclick="setFilter('out')">Sent Out</button>
          </div>
        </div>
        <ul class="tx-table" id="txList"></ul>
      </section>
    </div>

    <footer class="footer">
      Meridian Banking Demo UI • Simulated Ledger &amp; Controls • Static GitHub Pages Preview
    </footer>
  </div>

  <script>
    if (sessionStorage.getItem("meridianAuth") !== "true") {
      window.location.href = "login.html";
    }

    let balance = 2500000.00;
    let masked = false;
    let bankBlocked = false;
    let currentFilter = "all";

    const holderSaved = sessionStorage.getItem("meridianDemoUser");
    if (holderSaved) {
      document.getElementById("sessionHolder").textContent = holderSaved;
    }

    // Multi-item history of received (in) and sent out (out) sample transactions
    const transactions = [
      { type: "in",  title: "Wire Received — Apex Industrial Supply",  meta: "Nov 24, 2026 • Fedwire #FW-88412",  amount: 84500.00 },
      { type: "out", title: "Sent Out — Northstar Freight & Cargo",   meta: "Nov 23, 2026 • ACH Debit #AC-44109", amount: 19250.00 },
      { type: "in",  title: "Incoming Settlement — Ligon Kelley",     meta: "Nov 21, 2026 • Internal Transfer #IT-3091", amount: 62000.00 },
      { type: "out", title: "Sent Out — Meridian Legal & Tax Group",  meta: "Nov 19, 2026 • Wire Out #WO-77204",  amount: 14800.00 },
      { type: "in",  title: "Client Invoice Payment — BlueRidge Co.", meta: "Nov 17, 2026 • ACH Credit #AC-99210", amount: 53400.00 },
      { type: "out", title: "Sent Out — Pacific Warehouse Lease",     meta: "Nov 15, 2026 • ACH Debit #AC-43881", amount: 28500.00 },
      { type: "in",  title: "Incoming Distribution — Lena Baker",      meta: "Nov 12, 2026 • Internal Transfer #IT-3044", amount: 41000.00 },
      { type: "out", title: "Sent Out — Summit Equipment Leasing",    meta: "Nov 10, 2026 • Wire Out #WO-76890",  amount: 16750.00 },
      { type: "in",  title: "Received Payment — Crestview Holdings",  meta: "Nov 07, 2026 • Fedwire #FW-87902",  amount: 95000.00 },
      { type: "out", title: "Sent Out — Clearview Insurance Broker",  meta: "Nov 04, 2026 • ACH Debit #AC-43115", amount: 8900.00 }
    ];

    function formatMoney(val) {
      return "$" + val.toLocaleString("en-US", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    function renderBalance() {
      document.getElementById("balanceText").textContent =
        masked ? "••••••••••••" : formatMoney(balance);
    }

    function renderTransactions() {
      const list = document.getElementById("txList");
      list.innerHTML = "";

      const filtered = transactions.filter(t => {
        if (currentFilter === "in") return t.type === "in";
        if (currentFilter === "out") return t.type === "out";
        return true;
      });

      filtered.forEach(t => {
        const isIn = t.type === "in";
        const li = document.createElement("li");
        li.className = "tx-row";
        li.innerHTML = `
          <div>
            <div class="tx-title">${t.title}</div>
            <div class="tx-meta">${t.meta} • Sample</div>
          </div>
          <div class="tx-right">
            <div class="${isIn ? "amt-in" : "amt-out"}">${isIn ? "+" : "-"}${formatMoney(t.amount)}</div>
            <span class="tx-tag ${isIn ? "tag-in" : "tag-out"}">${isIn ? "RECEIVED" : "SENT OUT"}</span>
          </div>
        `;
        list.appendChild(li);
      });
    }

    function setFilter(mode) {
      currentFilter = mode;
      ["all", "in", "out"].forEach(id => {
        document.getElementById("f-" + id).classList.toggle("active", id === mode);
      });
      renderTransactions();
    }

    function togglePrivacy() {
      masked = !masked;
      renderBalance();
    }

    function toggleDrawer() {
      document.getElementById("transferDrawer").classList.toggle("open");
      document.getElementById("feedbackMsg").textContent = "";
    }

    function toggleBankBlock() {
      bankBlocked = !bankBlocked;
      const banner = document.getElementById("blockBanner");
      const label = document.getElementById("blockStateLabel");
      const btn = document.getElementById("blockBtn");
      const avail = document.getElementById("availBadge");

      if (bankBlocked) {
        banner.classList.add("active");
        label.textContent = "ACTIVE BLOCK (Demo)";
        btn.textContent = "Remove Bank Block";
        avail.textContent = "Outbound Blocked • Security Hold";
        avail.classList.add("status-blocked");
      } else {
        banner.classList.remove("active");
        label.textContent = "None (Unblocked)";
        btn.textContent = "Apply Bank Block";
        avail.textContent = "Funds Available • Active Standing";
        avail.classList.remove("status-blocked");
      }
    }

    function simulateReceived() {
      const incomingAmt = 18500.00;
      balance += incomingAmt;
      renderBalance();
      transactions.unshift({
        type: "in",
        title: "Received Credit — Clearing Settlement",
        meta: "Today • Simulated Incoming",
        amount: incomingAmt
      });
      renderTransactions();
    }

    function sendDemoFunds() {
      const msg = document.getElementById("feedbackMsg");
      if (bankBlocked) {
        msg.style.color = "#dc2626";
        msg.textContent = "Transfer blocked: Bank Block is active on this demo account.";
        return;
      }

      const recipient = document.getElementById("payTo").value.trim() || "External Beneficiary";
      const amt = parseFloat(document.getElementById("payAmt").value);

      if (isNaN(amt) || amt <= 0) {
        msg.style.color = "#dc2626";
        msg.textContent = "Enter a valid positive dollar amount.";
        return;
      }

      if (amt > balance) {
        msg.style.color = "#dc2626";
        msg.textContent = "Amount exceeds current demo balance.";
        return;
      }

      balance -= amt;
      renderBalance();
      transactions.unshift({
        type: "out",
        title: "Sent Out — " + recipient,
        meta: "Today • Simulated Outbound",
        amount: amt
      });
      renderTransactions();

      document.getElementById("payTo").value = "";
      document.getElementById("payAmt").value = "";
      msg.style.color = "#059669";
      msg.textContent = "Sent-out transaction added to history.";
    }

    function signOut() {
      sessionStorage.removeItem("meridianAuth");
      sessionStorage.removeItem("meridianDemoUser");
      window.location.href = "login.html";
    }

    renderBalance();
    renderTransactions();
  </script>
</body>
</html>
